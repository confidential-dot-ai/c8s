# Presets are applied at image build time. Both RKE2 units are enabled;
# the authenticated launch verdict selects exactly one at each boot.
# The packaged nginx default must never open an unauthenticated listener.
disable nginx.service
enable containerd-data-disk.service
enable models-disk.service
enable nri-node-ip.service
enable gpu-node-label.service
enable gpu-cc-enforce.service
enable scratch-enforce.service
enable c8s-modules-latch.service
enable rke2-role.service
enable c8s-join-release.service
enable c8s-join.service
enable rke2-server.service
enable rke2-agent.service
enable systemd-timesyncd.service
enable cred-release.service
enable cds.service
enable ratls-mesh.service
enable ratls-mesh-iptables.service
enable c8s-get-cert.service
enable cds-attest.service
enable allowlist-proxy.service
enable c8s-nginx.service
enable attest-proxy.service
# Check the running LSM and exercise a real policy before RKE2 can start.
enable apparmor-enforce.service
# The apparmor package supplies apparmor_parser and aa-exec for the boot
# probe. Its unit would load the package's stock
# host profiles from /etc/apparmor.d at boot; none of them are wanted on a
# node, and one (nvidia_modprobe) sits on the GPU path.
disable apparmor.service
