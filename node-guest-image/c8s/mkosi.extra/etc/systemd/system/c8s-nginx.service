[Unit]
Description=Measured node HTTPS front door
Requires=rke2-role.service c8s-get-cert.service
After=rke2-role.service c8s-get-cert.service cds-attest.service allowlist-proxy.service
ConditionPathExists=/run/confos/role-server
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStartPre=/bin/sh -c 'for _ in $(seq 1 120); do [ -s /run/c8s-tls/cert.pem ] && [ -s /run/c8s-tls/key.pem ] && [ -s /run/c8s-tls/ca.pem ] && exit 0; sleep 5; done; exit 1'
ExecStartPre=/usr/sbin/nginx -e stderr -t -c /run/confos/launch/nginx.conf
ExecStart=/usr/sbin/nginx -e stderr -c /run/confos/launch/nginx.conf -g "daemon off;"
ExecReload=/bin/kill -HUP $MAINPID
StandardError=journal
Restart=on-failure
RestartSec=5
TimeoutStartSec=630
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run /var/lib/nginx
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID CAP_CHOWN CAP_KILL

[Install]
WantedBy=multi-user.target
