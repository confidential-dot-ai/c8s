[Unit]
Description=Release agent credentials to authorized measured followers
Requires=rke2-role.service attestation-api.service
After=rke2-role.service attestation-api.service rke2-server.service
ConditionPathExists=/run/confos/role-server
ConditionPathExists=/run/confos/launch/followers.json
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/local/bin/c8s node-services run join-release
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
