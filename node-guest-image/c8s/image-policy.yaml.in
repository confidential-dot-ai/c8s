# Measured NRI bootstrap base allowlist. mkosi.sync pins the operator image and RKE2
# system images at build time. Authenticated launch staging selects the CDS
# endpoint and complete server image/key policy before containerd starts.
# The immutable source remains /usr/lib/c8s/image-policy.yaml; the staged copy
# under /etc/nri is writable only through the node's ephemeral state overlay.
platform: "@PLATFORM@"

plugin:
  health_addr: "unix:///var/run/nri-image-policy/health.sock"

# The node-CVM admission inventory (c8s docs/ratls.md, "Sandbox identity").
# get-cert dials this socket for its pod's digests before CDS will issue a
# certificate. Authenticated launch staging preserves this baked inventory
# configuration; without it the socket is never created and every adopted workload
# hangs waiting for a certificate that cannot be issued.
workload_claims:
  socket_dir: "/var/run/nri-image-policy"
  # The plugin is launched by containerd on the host, so its /proc is the
  # host's — a caller PID from SO_PEERCRED resolves directly.
  proc_root: "/proc"
  # Empty falls back to NodeIPFile (node-ip in socket_dir). After authenticated
  # launch staging, nri-node-ip.service publishes the node address before
  # either RKE2 role starts. Without that file, this resolves to 127.0.0.1
  # and the plugin refuses
  # to start with "inventory host is not a routable unicast address".
  advertise_host: ""

allowlist:
  # Cold-boot base, in the allowlist document format. Generated system
  # entries explicitly allow mounts and any command line. Base policies
  # enforce all constraints at final admission, like served policies.
  # The operator/get-cert image resolves from C8S_REF by mkosi.sync. Core
  # services are measured host binaries. The local-path busybox helper is
  # admitted by argv-pinned entries in the served allowlist.
  # The generated block admits the baked RKE2 system images (static pods,
  # Cilium, CoreDNS, local-path-storage) by the digests containerd computes
  # when it imports the airgap bundles at boot — not registry digests.
  base:
    schema: c8s.allowlist/v1
    workloads:
      operator:
        label: "@OPERATOR_IMAGE@"
        containers:
          - digest: "@OPERATOR_DIGEST@"
            image: "@OPERATOR_IMAGE@"
            command: {policy: any}
            args: {policy: any}
            mounts: {policy: any}
      # BEGIN rke2 system images (generated by systemfloor; regenerate on an RKE2 pin bump)
      hardened-addon-resizer-8026310fc44d:
        label: "docker.io/rancher/hardened-addon-resizer:1.8.23-build20260819"
        containers:
          - digest: "sha256:8026310fc44d985bf7c02434ad11d5f826a1aa1567606eea121b24ba9b3b0590"
            image: "docker.io/rancher/hardened-addon-resizer:1.8.23-build20260819"
            command: {policy: any}
            args: {policy: any}
            mounts: {policy: any}
      hardened-cluster-autoscaler-c9b9b027e4d2:
        label: "docker.io/rancher/hardened-cluster-autoscaler:v1.10.3-build20260819"
        containers:
          - digest: "sha256:c9b9b027e4d2cf1731311f9714f4aa633d37d7b0a72c9d3e6fc7a0594350d27c"
            image: "docker.io/rancher/hardened-cluster-autoscaler:v1.10.3-build20260819"
            command: {policy: any}
            args: {policy: any}
            mounts: {policy: any}
      hardened-cni-plugins-0d26512c90d9:
        label: "docker.io/rancher/hardened-cni-plugins:v1.9.1-build20260717"
        containers:
          - digest: "sha256:0d26512c90d935db3180f47a7a716e3dfac0847ec29076fb5487e535125a86a8"
            image: "docker.io/rancher/hardened-cni-plugins:v1.9.1-build20260717"
            command: {policy: any}
            args: {policy: any}
            mounts: {policy: any}
      hardened-coredns-e9435ef6526a:
        label: "docker.io/rancher/hardened-coredns:v1.14.7-build20260819"
        containers:
          - digest: "sha256:e9435ef6526a98e8d01d98a85d23770859ca49028ebd282912ae5e76f92c0166"
            image: "docker.io/rancher/hardened-coredns:v1.14.7-build20260819"
