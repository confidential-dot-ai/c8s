# Baked c8s chart install — TEMPLATE: mkosi.sync renders this to
# var/lib/rancher/rke2/server/manifests/c8s-chart.yaml at build time,
# substituting @CHART_CONTENT@ (the packed chart tree, base64) and the
# @*_DIGEST@ tokens resolved for every component the chart renders in node
# mode. Edit this file, not the generated one — node-guest-image-invariants.sh
# enforces that this template stays outside mkosi.extra, so mkosi never bakes
# the raw, unrendered copy.
#
# RKE2's supervisor applies manifests under server/manifests/ as HelmChart
# AddOns (helm-controller reconciles a helm-install-c8s Job from this CRD;
# see local-path-storage.yaml and rke2-cilium-config.yaml for the same
# mechanism). Deploying the chart this way, from the measured root, means the
# node's launch measurement covers exactly which chart version and which
# component images install, so the credential `c8s cred-release` hands an
# operator no longer needs the RBAC breadth a live `c8s install` requires to
# do the same job (see the node-image credential-release design).
#
# valuesContent below mirrors appendCvmModeInstallArgs(cvmMode="node") and
# appendResolvedDigestArgs in cmd/c8s/install.go: it is the values shape
# `c8s install --cvm-mode=node --hardware-platform=@PLATFORM@ --single-node`
# would compute for the components node mode renders (operator, cds,
# ratls-mesh, nriImagePolicy — attestationApi and volumed stay off, matching
# the node-mode install), minus the values only a running boot knows
# (cds.operatorKeys, cds.measurements/rtmrs, ratlsMesh.measurements/rtmrs).
# c8s-chart-values.service layers those on top at boot via a
# HelmChartConfig, which RKE2 merges into this HelmChart's spec without
# touching the measured copy here.
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: c8s
  namespace: kube-system
  labels:
    # c8s install refuses to run against a cluster carrying this label (the
    # baked-chart detection) — a live install would fight the AddOn
    # controller's own reconciliation of this release and cannot supply the
    # boot-only values above. See preflightNotBaked in cmd/c8s/install.go.
    confidential.ai/baked: "true"
spec:
  chartContent: "@CHART_CONTENT@"
  targetNamespace: c8s-system
  createNamespace: false
  valuesContent: |
    image:
      repository: ghcr.io/confidential-dot-ai/c8s-operator
      digest: "@IMAGE_DIGEST@"
    cds:
      image:
        repository: ghcr.io/confidential-dot-ai/cds
        digest: "@CDS_DIGEST@"
      ratlsPlatform: "@RATLS_PLATFORM@"
      node:
        selector: null
        tolerations: null
    ratlsMesh:
      image:
        repository: ghcr.io/confidential-dot-ai/ratls-mesh
        digest: "@RATLS_MESH_DIGEST@"
      platform: "@RATLS_MESH_PLATFORM@"
    attestationApi:
      enabled: false
      cvmMode: node
      teeDevices:
        sevGuest: @TEE_SEV_GUEST@
        tdxGuest: @TEE_TDX_GUEST@
        tpm: false
    tlsLb:
      attest:
        # The evidence shape the attest sidecar asks the attestation-api for:
        # tdx on a TDX build (generation is AMD-only, so blank), the chart
        # defaults (snp, genoa) on SNP.
        platform: "@TLS_LB_ATTEST_PLATFORM@"
        generation: "@TLS_LB_ATTEST_GENERATION@"
    nriImagePolicy:
      enabled: true
      baked: true
      distro: rke2
      bootstrapAllowlist:
        deriveComponents: true
      image:
        repository: ghcr.io/confidential-dot-ai/nri-image-policy
        digest: "@NRI_IMAGE_POLICY_DIGEST@"
