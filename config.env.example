# confidential-ci deployment config.
# Copy to config.env, edit for the target GCP account/GitHub org, then:
#   set -a; source config.env; set +a
# before running host/*.sh and the runner-image build. Every script reads these
# with sane defaults, so retargeting to the company's main GCP account = edit here.

# ---- GCP ----
export GCP_PROJECT=conf-500518          # company GCP project id
export GCP_ZONE=us-central1-a           # host (ARC) cluster zone
export GCP_REGION=us-central1           # Artifact Registry region + Model-B region
export HOST_CLUSTER=arc-host            # ARC host cluster name

# ---- Runner image (Artifact Registry) ----
export AR_REPO=confidential-ci
export IMAGE=confidential-runner-gcp
export IMAGE_TAG=latest
# Full ref the scale set pulls (used in helm --set template...image=...):
export RUNNER_IMAGE="${GCP_REGION}-docker.pkg.dev/${GCP_PROJECT}/${AR_REPO}/${IMAGE}:${IMAGE_TAG}"

# ---- GitHub (org-wide) ----
export ORG_URL=https://github.com/YOUR_ORG
export RUNNER_GROUP=confidential
# Auth — prefer a GitHub App for org-wide (no human's PAT, scoped, rotatable):
#   export GH_APP_ID=...  GH_APP_INSTALL_ID=...  GH_APP_KEY=path/to/app-key.pem
# Quick test only (a PAT with admin:org):
#   export GH_RUNNER_TOKEN="$(gh auth token)"

# ---- Workload Identity (keyless GCP from runner pods) ----
export RUNNER_NS=arc-runners
export KSA=arc-e2e
export GSA=arc-e2e

# ---- E2E (Model B ephemeral confidential cluster) ----
export CONF_TYPE=sev                    # sev (broad capacity) | sev_snp | tdx

# ---- Eligibility reminder ----
# Repos using the self-hosted runners must be PRIVATE/internal. GitHub will not
# dispatch self-hosted runners on PUBLIC repos (see OPEN-SOURCE.md / MONITORING.md).
